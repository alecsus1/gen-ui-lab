# ============================
# IMPORT
# ============================
import json
import os
import re
import requests
from typing import Optional

from fastapi import FastAPI
from fastapi.responses import PlainTextResponse
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

from influxdb import InfluxDBClient
from openai import OpenAI

# ============================
# CONFIG
# ============================
INFLUX_HOST = os.getenv("INFLUX_HOST", "influxdb")
INFLUX_PORT = int(os.getenv("INFLUX_PORT", "8086"))
INFLUX_DB = os.getenv("INFLUX_DB", "garmin")

# ============================
# CLIENTS
# ============================
influx_client = InfluxDBClient(
    host=INFLUX_HOST,
    port=INFLUX_PORT,
    database=INFLUX_DB
)

def get_thesys_client() -> OpenAI:
    key = os.environ.get("THESYS_API_KEY")
    if not key or key == "None":
        raise RuntimeError("THESYS_API_KEY mancante nel container.")
    return OpenAI(base_url="https://api.thesys.dev/v1/embed", api_key=key)

# ============================
# APP
# ============================
app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ============================
# THESYS HISTORY
# ============================
thesys_history = [
    {
        "role": "system",
        "content": (
            "You are a UI generation assistant. "
            "You receive structured data and must generate "
            "dashboard UI specifications in JSON format."
        ),
    }
]

def call_thesys(user_prompt: str, dataset: list):
    thesys_client = get_thesys_client()

    enriched_prompt = f"""
User request:
{user_prompt}

Available dataset (JSON):
{json.dumps(dataset, indent=2)}

Generate an interactive dashboard UI specification.
""".strip()

    thesys_history.append({"role": "user", "content": enriched_prompt})

    completion = thesys_client.chat.completions.create(
        model="c1/openai/gpt-5/v-20250915",
        messages=thesys_history,
        temperature=0.2,
    )

    assistant_message = completion.choices[0].message
    thesys_history.append(assistant_message)
    return assistant_message.content

# ============================
# INFLUX HELPERS
# ============================
def build_time_clause(time_range: str) -> str:
    if time_range == "last_1h":
        return "time > now() - 1h"
    if time_range == "last_24h":
        return "time > now() - 24h"
    return "time > now() - 24h"

def query_influx(metrics: list, time_range: str):
    select_fields = [f"mean({m}) AS {m}" for m in metrics]
    select_clause = ", ".join(select_fields)
    where_clause = build_time_clause(time_range)

    query = f"""
SELECT {select_clause}
FROM wearable_metrics
WHERE {where_clause}
GROUP BY time(5m)
fill(previous)
""".strip()

    result = influx_client.query(query)
    return list(result.get_points())

def normalize_points(points: list, metrics: list):
    dataset = []
    for p in points:
        row = {"time": p.get("time")}
        for m in metrics:
            row[m] = p.get(m)
        dataset.append(row)
    return dataset

# ============================
# LLAMA (OLLAMA)
# ============================
conversation_memory_by_thread: dict[str, list[dict]] = {}


SYSTEM_PROMPT = """
You are an AI assistant for a wearable analytics application.

Your task:
- Understand the user's request
- Decide which wearable metrics are needed
- Decide the time range
- Decide the chart type

IMPORTANT RULES:
- Respond ONLY with valid JSON
- Do NOT add explanations
- Do NOT add markdown
- Do NOT add text outside JSON

JSON schema:
{
  "metrics": ["stress", "heart_rate", "steps", "calories", "distance"],
  "time_range": "last_1h | last_24h",
  "chart": "line | bar | area",
  "title": "string"
}
""".strip()

def ask_llama(user_prompt: str, history: list[dict]):
    messages = [{"role": "system", "content": SYSTEM_PROMPT}]
    messages.extend(history)
    messages.append({"role": "user", "content": user_prompt})

    payload = {"model": "llama2", "messages": messages, "stream": False}
    r = requests.post("http://ollama:11434/api/chat", json=payload, timeout=60)

    if r.status_code != 200:
        return {"metrics": ["stress"], "time_range": "last_24h", "chart": "line", "title": "Stress (24h)"}

    content = r.json()["message"]["content"]

    try:
        return json.loads(content)
    except Exception:
        return {"metrics": ["stress"], "time_range": "last_24h", "chart": "line", "title": "Stress (24h)"}

# ============================
# C1Chat REQUEST MODELS
# ============================
CONTENT_RE = re.compile(r"<content[^>]*>(.*?)</content>", re.DOTALL)

def extract_user_text(c1_content: str) -> str:
    m = CONTENT_RE.search(c1_content or "")
    return (m.group(1) if m else (c1_content or "")).strip()

class C1Prompt(BaseModel):
    id: Optional[str] = None
    role: Optional[str] = None
    content: str

class ChatRequest(BaseModel):
    prompt: C1Prompt
    responseId: Optional[str] = None
    threadId: Optional[str] = None

# ============================
# ENDPOINT
# ============================
@app.post("/chat", response_class=PlainTextResponse)
def chat(request: ChatRequest):
    user_prompt = extract_user_text(request.prompt.content)
    thread_id = request.threadId or "default"
    history = conversation_memory_by_thread.setdefault(thread_id, [])

    intent = ask_llama(user_prompt, history)
    history.append({"role":"user","content": user_prompt})
    history.append({"role":"assistant","content": json.dumps(intent)})

    # Hard safety: se LLM sballa
    metrics = intent.get("metrics") or ["stress"]
    time_range = intent.get("time_range") or "last_24h"

    raw_points = query_influx(metrics=metrics, time_range=time_range)
    dataset = normalize_points(raw_points, metrics)

    return call_thesys(user_prompt=user_prompt, dataset=dataset)

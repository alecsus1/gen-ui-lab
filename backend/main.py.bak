# ============================
# IMPORT STANDARD
# ============================

# FastAPI: framework web
from fastapi import FastAPI
from fastapi.responses import PlainTextResponse
# Modelli di input/output
from pydantic import BaseModel

# Per chiamare Ollama via HTTP
import requests

# Per gestire JSON (parse / dump)
import json
import os
from openai import OpenAI
# Client ufficiale InfluxDB v1
from influxdb import InfluxDBClient
from fastapi.middleware.cors import CORSMiddleware


# ============================
# CONFIGURAZIONE INFLUXDB
# ============================

INFLUX_HOST = "influxdb"   # nome servizio Docker
INFLUX_PORT = 8086
INFLUX_DB = "garmin"

THESYS_API_KEY= os.getenv("THESYS_API_KEY")

# Creiamo il client InfluxDB
influx_client = InfluxDBClient(
    host=INFLUX_HOST,
    port=INFLUX_PORT,
    database=INFLUX_DB
)
# ============================
# CREAZIONE APP FASTAPI
# ============================

app = FastAPI()


# ============================
# CORS
# ============================
# Serve per permettere al frontend React (localhost:3000)
# di chiamare il backend (localhost:8000)

from fastapi.middleware.cors import CORSMiddleware

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],          # In sviluppo permettiamo tutto
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ============================
# CLIENT THESYS C1
# ============================

def get_thesys_client() -> OpenAI:
    key = os.environ.get("THESYS_API_KEY")
    if not key or key == "None":
        raise RuntimeError("THESYS_API_KEY mancante nel container (Compose non la sta passando).")
    return OpenAI(base_url="https://api.thesys.dev/v1/embed", api_key=key)

# --- Inizializza il client Thesys C1 ---
# thesys_client = get_thesys_client()


# ============================
# MEMORIA CONVERSAZIONE THESYS
# ============================

thesys_history = [
    {
        "role": "system",
        "content": (
            "You are a UI generation assistant. "
            "You receive structured data and must generate "
            "dashboard UI specifications in JSON format."
        )
    }
]
# ============================
# FUNZIONE PER CHIAMARE THESYS
# ============================
def call_thesys(user_prompt: str, dataset: list):
    """
    Invia a Thesys:
    - contesto conversazionale
    - richiesta utente
    - dataset reale
    e riceve una UI specification.
    """

    # ✅ Inizializziamo il client QUI (runtime, non import-time)
    thesys_client = get_thesys_client()

    enriched_prompt = f"""
User request:
{user_prompt}

Available dataset (JSON):
{json.dumps(dataset, indent=2)}

Generate an interactive dashboard UI specification.
"""

    thesys_history.append({
        "role": "user",
        "content": enriched_prompt
    })

    completion = thesys_client.chat.completions.create(
        model="c1/openai/gpt-5/v-20250915",
        messages=thesys_history,
        temperature=0.2
    )


    assistant_message = completion.choices[0].message
    thesys_history.append(assistant_message)

    return assistant_message.content


# ============================
# TIME RANGE → WHERE CLAUSE
# ============================

def build_time_clause(time_range: str) -> str:
    if time_range == "last_1h":
        return "time > now() - 1h"
    if time_range == "last_24h":
        return "time > now() - 24h"
    # Default: ultima 24h (evitiamo today() che può rompere)
    return "time > now() - 24h"

# ============================
# QUERY DINAMICA INFLUXDB
# ============================

def query_influx(metrics: list, time_range: str):
    """
    Costruisce ed esegue una query InfluxDB
    in base alle metriche e al time range richiesti.
    """

    # Costruiamo la SELECT (es: mean(stress), mean(heart_rate))
    select_fields = []
    for m in metrics:
        select_fields.append(f"mean({m}) AS {m}")

    select_clause = ", ".join(select_fields)

    # Costruiamo la WHERE
    where_clause = build_time_clause(time_range)

    # Query finale
    query = f"""
    SELECT {select_clause}
    FROM wearable_metrics
    WHERE {where_clause}
    GROUP BY time(5m)
    fill(null)
    """

    # Eseguiamo la query
    result = influx_client.query(query)

    return list(result.get_points())
# ============================
# NORMALIZZAZIONE DATASET
# ============================

def normalize_points(points: list, metrics: list):
    """
    Trasforma i punti InfluxDB in un array JSON
    uniforme per frontend / Thesys C1.
    """

    dataset = []

    for p in points:
        row = {
            "time": p["time"]
        }

        for m in metrics:
            row[m] = p.get(m)

        dataset.append(row)

    return dataset


# ============================
# MODELLO REQUEST
# ============================
# Questo rappresenta il body JSON che arriva dal frontend

class ChatRequest(BaseModel):
    prompt: str


# ============================
# MEMORIA CONVERSAZIONALE
# ============================
# Lista in RAM che mantiene lo storico della conversazione
# Ogni elemento segue il formato "chat style":
# {
#   "role": "user" | "assistant",
#   "content": "testo"
# }

conversation_memory = []


# ============================
# SYSTEM PROMPT (FONDAMENTALE)
# ============================
# Qui diciamo a llama2 COME deve comportarsi.
# Deve:
# - interpretare la richiesta
# - NON rispondere in linguaggio naturale
# - restituire SOLO JSON valido

SYSTEM_PROMPT = """
You are an AI assistant for a wearable analytics application.

Your task:
- Understand the user's request
- Decide which wearable metrics are needed
- Decide the time range
- Decide the chart type

IMPORTANT RULES:
- Respond ONLY with valid JSON
- Do NOT add explanations
- Do NOT add markdown
- Do NOT add text outside JSON

JSON schema:
{
  "metrics": ["stress", "heart_rate", "steps", "calories", "distance"],
  "time_range": "today | last_1h | last_24h",
  "chart": "line | bar | area",
  "title": "string"
}
"""


# ============================
# FUNZIONE: CHIAMATA A LLAMA2
# ============================

def ask_llama(user_prompt: str):
    """
    Invia il prompt a Ollama (llama2) includendo:
    - system prompt
    - memoria conversazionale
    - messaggio utente corrente

    Ritorna:
    - un dict Python (JSON parsato)
    """

    # Lista messaggi da inviare al modello
    messages = []

    # 1) Aggiungiamo il system prompt (regole fisse)
    messages.append({
        "role": "system",
        "content": SYSTEM_PROMPT
    })

    # 2) Aggiungiamo tutta la memoria precedente
    for msg in conversation_memory:
        messages.append(msg)

    # 3) Aggiungiamo il nuovo messaggio utente
    messages.append({
        "role": "user",
        "content": user_prompt
    })

    # Payload per l'API chat di Ollama
    payload = {
        "model": "llama2",      # nome modello installato in Ollama
        "messages": messages,
        "stream": False
    }

    # Chiamata HTTP a Ollama (container ollama)
    response = requests.post(
        "http://ollama:11434/api/chat",
        json=payload,
        timeout=60
    )

    # Se Ollama risponde con errore HTTP
    if response.status_code != 200:
        return {
            "error": f"Ollama HTTP {response.status_code}: {response.text}"
        }

    # Parsing risposta JSON
    data = response.json()

    # Estraiamo SOLO il contenuto del messaggio del modello
    # (che DEVE essere JSON puro)
    content = data["message"]["content"]

    # Convertiamo la stringa JSON in dict Python
    return json.loads(content)



# ============================
# MODELLO REQUEST
# ============================

class ChatRequest(BaseModel):
    prompt: str


# ============================
# ENDPOINT /chat
# ============================

@app.post("/chat", response_class=PlainTextResponse)
def chat(request: ChatRequest):
    """
    Pipeline completa:
    1) Prompt utente
    2) Interpretazione con Llama2 (intent)
    3) Query dati reali da InfluxDB
    4) Generazione UI con Thesys C1
    5) Ritorno STRINGA C1 al frontend
    """

    # ------------------------------------------------
    # 1️⃣ PRENDIAMO IL PROMPT DELL'UTENTE
    # ------------------------------------------------
    user_prompt = request.prompt

    # ------------------------------------------------
    # 2️⃣ INTERPRETAZIONE SEMANTICA (LLAMA2)
    #    → estrae metriche, time range, tipo grafico
    # ------------------------------------------------
    intent = ask_llama(user_prompt)

    # Esempio di intent atteso:
    # {
    #   "metrics": ["heart_rate", "stress"],
    #   "time_range": "24h"
    # }

    # ------------------------------------------------
    # 3️⃣ QUERY AI DATI REALI (INFLUXDB)
    # ------------------------------------------------
    raw_points = query_influx(
        metrics=intent["metrics"],
        time_range=intent["time_range"]
    )

    # ------------------------------------------------
    # 4️⃣ NORMALIZZAZIONE DATI
    #    → lista di dict JSON-friendly
    # ------------------------------------------------
    dataset = normalize_points(
        raw_points,
        intent["metrics"]
    )

    # dataset esempio:
    # [
    #   { "time": "...", "heart_rate": 82, "stress": 12.3 },
    #   { "time": "...", "heart_rate": 85, "stress": 14.1 }
    # ]

    # ------------------------------------------------
    # 5️⃣ GENERAZIONE UI CON THESYS C1
    #    ⚠️ RITORNA STRINGA (markup C1)
    # ------------------------------------------------
    c1_ui_response = call_thesys(
        user_prompt=user_prompt,
        dataset=dataset
    )

    # ------------------------------------------------
    # 6️⃣ RITORNO AL FRONTEND
    #    ⚠️ NON JSON
    #    ⚠️ SOLO STRINGA C1
    # ------------------------------------------------
    return c1_ui_response